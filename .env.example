# Copy to .env for local development. Never commit real credentials.
APP_ENV=development
APP_LOG_LEVEL=INFO
# Local-only application secret; production must inject a strong random value.
APP_SECRET_KEY=local-development-only-change-me

# Local Compose services
POSTGRES_DB=platform
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform-local-only
DATABASE_URL=postgresql+asyncpg://platform:platform-local-only@postgres:5432/platform
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=["http://localhost:5173"]

# Leave empty to use the fake Telegram adapter. Never commit a real token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADAPTER=fake

# Browser-facing API URL for the local Mini App.
VITE_API_BASE_URL=http://localhost:8000
